# Copiar a .env y completar. NUNCA subir .env al repositorio.

APP_NAME="Gestión RR. HH."
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
# Ajustar a la zona horaria de la empresa.
APP_TIMEZONE=UTC

# Base de datos MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestion_rrhh
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Sesión
SESSION_NAME=gestion_rrhh_session
SESSION_LIFETIME=120
# true en producción con HTTPS.
SESSION_SECURE=false
