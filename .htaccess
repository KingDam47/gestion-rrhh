# InfinityFree no permite cambiar el document root.
# Este archivo redirige las peticiones a public/ y bloquea rutas internas.
# En local se recomienda configurar Apache con document root en public/.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dominio canonico: la URL publica es siempre https://evolvehr.cloud.
    # El subdominio temporal y el prefijo www redirigen con 301 conservando ruta y query.
    RewriteCond %{HTTP_HOST} ^(www\.)?evolvehr\.freehosting\.dev$ [NC,OR]
    RewriteCond %{HTTP_HOST} ^www\.evolvehr\.cloud$ [NC]
    RewriteRule ^ https://evolvehr.cloud%{REQUEST_URI} [R=301,L]

    # Forzar HTTPS (el hosting termina TLS y reporta HTTPS=on).
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Bloquear archivos y carpetas sensibles.
    RewriteRule ^\.env - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^(src|config|database|storage|tests|docs|scripts|exceso|\.github)(/|$) - [F,L]

    # Evitar reescribir lo que ya está dentro de public/.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
