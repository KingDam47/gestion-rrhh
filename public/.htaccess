# Front controller y cabeceras de seguridad.

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Servir archivos y directorios existentes.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Enviar el resto al front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    # Las respuestas dinámicas ya envían estas cabeceras desde Response.php.
    # Se limitan a los assets para no duplicarlas en el mismo response.
    <FilesMatch "\.(css|js|mjs|png|jpe?g|gif|svg|ico|webp|woff2?|ttf|eot)$">
        Header always set X-Content-Type-Options "nosniff"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
    </FilesMatch>
</IfModule>
