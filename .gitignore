# Entorno y secretos
.env
.env.*
!.env.example

# Dependencias
/vendor/
node_modules/
composer.phar

# Logs
/storage/logs/*
!/storage/logs/.gitkeep
*.log

# Limitador de login (solo contadores; no versionar)
/storage/rate-limits/*
!/storage/rate-limits/.gitkeep

# Backups y paquetes
/backups/
/dist/
/build/
*.zip
*.tar.gz

# PHPUnit y cobertura
/.phpunit.cache/
.phpunit.result.cache
/coverage/

# Editores y sistema
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Temporales
*.tmp
*.bak

# Artefactos de herramientas de análisis
/.ua/
